<div class="carte p-6 text-center mb-4">
  <span class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-dispo-fond">
    <span class="text-3xl font-bold text-dispo" aria-hidden="true">✓</span>
  </span>

  <p class="surtitre">Retour enregistré</p>
  <p class="titre-ouvrage mt-1 text-lg">« <%= loan.book.title %> »</p>
  <p class="text-sm text-texte-discret mt-1">
    Rendu par <%= loan.member.full_name %>
  </p>

  <% if loan.returned_late? %>
    <%# Le retard est mentionné mais sans reproche : il sert à décider s'il
        faut en parler à l'abonné, pas à le sanctionner. %>
    <p class="bandeau bandeau-attention mt-4 text-left">
      Rendu avec <%= loan.days_late %> jour<%= "s" if loan.days_late > 1 %> de retard,
      l'échéance était le <span class="donnee"><%= date_courte(loan.due_on) %></span>.
    </p>
  <% end %>

  <div class="mt-4 pt-4 border-t border-bordure">
    <p class="text-sm text-texte-discret">
      L'exemplaire est de nouveau disponible et
      <%= loan.member.full_name %> peut emprunter à nouveau.
    </p>
  </div>
</div>

<%= link_to "Nouveau retour", new_return_path, class: "bouton bouton-primaire bouton-large bouton-grand mb-3" %>
<%= link_to "Prêter un livre", new_loan_path(member_id: loan.member_id), class: "bouton bouton-contour bouton-large" %>
