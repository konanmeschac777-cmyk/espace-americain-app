<div class="carte p-6 text-center mb-4">
  <span class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-dispo-fond">
    <span class="text-3xl font-bold text-dispo" aria-hidden="true">✓</span>
  </span>

  <p class="surtitre">Abonné inscrit</p>
  <p class="font-titre text-xl font-extrabold text-encre mt-1"><%= member.full_name %></p>

  <%# Le numéro passe en très grand : c'est ce que le bibliothécaire doit
      recopier sur la carte physique avant de la remettre. %>
  <div class="mt-4 pt-4 border-t border-bordure">
    <p class="surtitre">À écrire sur la carte</p>
    <p class="donnee text-3xl font-bold text-navy leading-tight mt-1 tracking-tight">
      <%= member.card_number %>
    </p>
  </div>

  <p class="text-sm text-texte-discret mt-4">
    Adhésion valable jusqu'au
    <span class="donnee"><%= date_courte(member.expires_on) %></span>.
    <% if member.phone.blank? %>
      <br>Aucun téléphone enregistré, pense à le demander.
    <% end %>
  </p>
</div>

<%= link_to "Prêter un livre à #{member.first_name}", new_loan_path(member_id: member.id),
            class: "bouton bouton-primaire bouton-large bouton-grand mb-3" %>
<%= link_to "Inscrire quelqu'un d'autre", new_member_path,
            class: "bouton bouton-contour bouton-large" %>
