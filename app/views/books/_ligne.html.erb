<%= link_to book_path(book), class: "ligne-liste items-start", data: { turbo_frame: "_top" } do %>
  <%= dos_livre(book) %>

  <div class="min-w-0 flex-1">
    <span class="titre-ouvrage block"><%= book.title %></span>
    <span class="block text-sm text-texte-discret mt-0.5 truncate">
      <%= auteur(book) %><%= " · #{book.shelf_mark}" if book.shelf_mark.present? %>
    </span>
    <% if book.needs_completion? %>
      <span class="badge badge-attention mt-1 inline-block"><%= t("app.catalogue.a_completer") %></span>
    <% end %>
  </div>

  <%= badge_disponibilite(book) %>
<% end %>
