<% content_for :title, t("app.mot_de_passe.titre_page_nouveau") %>

<div class="max-w-[430px] mx-auto min-h-screen bg-white flex flex-col">
  <div class="h-[250px] relative overflow-hidden shrink-0 bg-navy">
    <%= image_tag "slide-1.jpg",
          alt: t("app.accueil.photo_groupe"),
          class: "absolute inset-0 w-full h-full object-cover" %>
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(10,34,64,0.34) 0%, rgba(10,34,64,0.10) 45%, rgba(10,34,64,0.28) 100%);"></div>
    <%= link_to new_session_path, class: "absolute left-[18px] top-[18px] h-9 w-9 rounded-full bg-white/90 flex items-center justify-center text-xl text-navy", "aria-label": "Retour" do %>
      &larr;
    <% end %>
  </div>

  <div class="panneau-releve flex-1 flex flex-col px-[26px] pb-[26px]">
    <div class="flex justify-center -mt-[26px]">
      <span class="bg-white rounded-lg px-[11px] py-[9px] flex items-center shadow-[0_3px_10px_rgba(10,34,64,0.14)]">
        <%= image_tag "american-spaces-mark.png", alt: "American Spaces", class: "h-[34px] w-auto" %>
      </span>
    </div>

    <div class="text-center mt-4">
      <p class="surtitre"><%= @user.email_address %></p>
      <h1 class="titre-ecran mt-1"><%= t("app.mot_de_passe.nouveau_mot_de_passe") %></h1>
    </div>

    <% if alert = flash[:alert] %>
      <p class="bandeau bandeau-blocage mt-5"><%= alert %></p>
    <% end %>

    <%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 flex flex-col gap-4" do |form| %>
      <div data-controller="mot-de-passe">
        <%= form.label :password, t("app.mot_de_passe.nouveau_mot_de_passe"), class: "libelle" %>
        <div class="flex items-center gap-2 bg-surface-alt rounded-[var(--radius-champ)] pr-4">
          <%= form.password_field :password, required: true,
                autocomplete: "new-password", maxlength: 72,
                class: "champ-plein !bg-transparent flex-1",
                data: { "mot-de-passe-target": "champ" } %>
          <button type="button" class="text-sm font-semibold text-navy shrink-0"
                  data-mot-de-passe-target="bouton" data-action="mot-de-passe#basculer"
                  data-afficher="<%= t("app.connexion.afficher") %>" data-masquer="<%= t("app.connexion.masquer") %>">
            <%= t("app.connexion.afficher") %>
          </button>
        </div>
      </div>

      <div>
        <%= form.label :password_confirmation, t("app.mot_de_passe.confirmer"), class: "libelle" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
              maxlength: 72, class: "champ-plein" %>
      </div>

      <div class="rounded-[var(--radius-bloc)] p-4 flex flex-col gap-2" style="background-color: var(--color-surface-alt);">
        <p class="text-sm text-texte-discret"><%= t("app.mot_de_passe.regle_longueur") %></p>
        <p class="text-sm text-texte-discret"><%= t("app.mot_de_passe.regle_majuscule") %></p>
        <p class="text-sm text-texte-discret"><%= t("app.mot_de_passe.regle_different") %></p>
      </div>

      <%= form.submit t("app.mot_de_passe.enregistrer_connecter"), class: "bouton bouton-primaire bouton-large mt-2" %>
    <% end %>

    <div class="flex-1"></div>
  </div>
</div>
