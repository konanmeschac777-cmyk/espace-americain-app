<% content_for :title, t("app.mot_de_passe.titre_page_oublie") %>

<div class="max-w-[430px] mx-auto min-h-screen bg-white flex flex-col">
  <div class="h-[250px] relative overflow-hidden shrink-0 bg-navy">
    <%= image_tag "slide-1.jpg",
          alt: t("app.accueil.photo_groupe"),
          class: "absolute inset-0 w-full h-full object-cover" %>
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(10,34,64,0.34) 0%, rgba(10,34,64,0.10) 45%, rgba(10,34,64,0.28) 100%);"></div>
    <%= link_to new_session_path, class: "absolute left-[18px] top-[18px] h-9 w-9 rounded-full bg-white/90 flex items-center justify-center text-xl text-navy", "aria-label": "Retour" do %>
      &larr;
    <% end %>
  </div>

  <div class="panneau-releve flex-1 flex flex-col px-[26px] pb-[26px]">
    <div class="flex justify-center -mt-[26px]">
      <span class="bg-white rounded-lg px-[11px] py-[9px] flex items-center shadow-[0_3px_10px_rgba(10,34,64,0.14)]">
        <%= image_tag "american-spaces-mark.png", alt: "American Spaces", class: "h-[34px] w-auto" %>
      </span>
    </div>

    <% if @offline %>
      <%# Serveur local sans internet : il n'y a pas d'e-mail à attendre, donc
          pas de formulaire à remplir. On donne directement la seule voie qui
          marche, la commande à passer sur le poste serveur. %>
      <div class="text-center mt-4">
        <p class="surtitre"><%= t("app.mot_de_passe.hors_ligne_eyebrow") %></p>
        <h1 class="titre-ecran mt-1"><%= t("app.mot_de_passe.hors_ligne_titre") %></h1>
        <p class="mt-2 text-sm leading-relaxed text-texte-estompe max-w-[33ch] mx-auto">
          <%= t("app.mot_de_passe.hors_ligne_texte") %>
        </p>
      </div>

      <div class="rounded-[var(--radius-bloc)] p-4 mt-5 text-left" style="background-color: var(--color-surface);">
        <p class="surtitre"><%= t("app.mot_de_passe.hors_ligne_marche_a_suivre") %></p>
        <p class="text-sm text-texte-discret mt-2"><%= t("app.mot_de_passe.hors_ligne_etape") %></p>
        <p class="donnee text-xs text-navy mt-3 rounded border border-bordure bg-white p-3 break-all">
          bin/rails "bibliothecaire:creer[<%= @email_address.presence || "adresse-du-compte" %>,nouveau-mot-de-passe]"
        </p>
      </div>

      <div class="flex-1"></div>

      <%= link_to t("app.mot_de_passe.retour_connexion"), new_session_path,
                  class: "bouton bouton-primaire bouton-large mt-4" %>
    <% elsif @sent %>
      <div class="text-center mt-4">
        <p class="surtitre"><%= t("app.mot_de_passe.eyebrow") %></p>
        <h1 class="titre-ecran mt-1"><%= t("app.mot_de_passe.lien_envoye_titre") %></h1>
        <p class="mt-2 text-sm leading-relaxed text-texte-estompe max-w-[33ch] mx-auto">
          <%= t("app.mot_de_passe.lien_envoye_texte") %>
        </p>
      </div>

      <div class="bg-surface-alt rounded-[var(--radius-bloc)] p-5 mt-5 text-center">
        <span class="mx-auto mb-3 flex h-11 w-11 items-center justify-center rounded-full bg-white text-xl" aria-hidden="true">✉</span>
        <p class="donnee text-navy truncate"><%= @email_address %></p>
        <p class="text-sm text-texte-discret mt-2"><%= t("app.mot_de_passe.lien_valable") %></p>
      </div>

      <div class="rounded-[var(--radius-bloc)] p-4 mt-4 text-left" style="background-color: var(--color-surface);">
        <p class="surtitre"><%= t("app.mot_de_passe.si_message_narrive_pas") %></p>
        <p class="text-sm text-texte-discret mt-2">
          <%= t("app.mot_de_passe.verifiez_indesirables") %>
        </p>
      </div>

      <div class="flex-1"></div>

      <a href="mailto:<%= @email_address %>" class="bouton bouton-primaire bouton-large mt-4"><%= t("app.mot_de_passe.ouvrir_boite_mail") %></a>
      <p class="text-center text-sm text-texte-discret mt-4">
        <%= t("app.mot_de_passe.rien_recu") %>
        <%= link_to t("app.mot_de_passe.renvoyer_lien"), new_password_path, class: "font-bold text-encre underline" %>
      </p>
    <% else %>
      <div class="text-center mt-4">
        <h1 class="titre-ecran"><%= t("app.mot_de_passe.titre_page_oublie") %></h1>
        <p class="mt-2 text-sm leading-relaxed text-texte-estompe max-w-[33ch] mx-auto">
          <%= t("app.mot_de_passe.description_formulaire") %>
        </p>
      </div>

      <% if alert = flash[:alert] %>
        <p class="bandeau bandeau-blocage mt-5"><%= alert %></p>
      <% end %>

      <%= form_with url: passwords_path, class: "mt-6 flex flex-col gap-4" do |form| %>
        <div>
          <%= form.label :email_address, t("app.connexion.email"), class: "libelle" %>
          <%= form.email_field :email_address, required: true, autofocus: true,
                autocomplete: "username", value: params[:email_address],
                placeholder: "bibliothecaire@shelf.ci", class: "champ-plein" %>
        </div>

        <%= form.submit t("app.mot_de_passe.envoyer_lien"), class: "bouton bouton-primaire bouton-large mt-2" %>
      <% end %>

      <div class="flex-1"></div>

      <%= link_to t("app.mot_de_passe.retour_connexion"), new_session_path,
                  class: "block text-center text-sm text-texte-estompe underline mt-6" %>
    <% end %>
  </div>
</div>
