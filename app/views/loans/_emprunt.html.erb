<details class="ligne-details <%= 'tres-en-retard' if loan.long_overdue? %>">
  <summary>
    <span class="min-w-0 flex-1">
      <span class="titre-ouvrage block"><%= loan.book.title %></span>

      <span class="block text-sm text-texte-discret truncate">
        <%= loan.member.full_name %>
        <span class="donnee text-texte-estompe"><%= loan.member.card_number %></span>
      </span>

      <span class="block text-sm text-texte-estompe">
        <%= t("app.admin.echeance") %> <span class="donnee"><%= date_courte(loan.due_on) %></span>
        <% if loan.renewals_count.positive? %>
          &middot; <%= t("app.admin.deja_renouvele") %>
        <% end %>
      </span>

      <span class="block mt-2"><%= badge_echeance(loan) %></span>
    </span>

    <svg class="chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </summary>

  <div class="panneau-actions">
    <%= button_to t("app.pret.enregistrer_retour"), returns_path(loan_id: loan.id),
                  class: "bouton bouton-primaire bouton-large",
                  form: { data: { turbo_confirm: t("app.pret.confirmer_retour", titre: loan.book.title) } } %>

    <% if loan.renewable? %>
      <%= button_to t("app.admin.renouveler_jours", jours: Setting.loan_days), renew_loan_path(loan),
                    class: "bouton bouton-contour bouton-large" %>
    <% else %>
      <%# Le bouton reste visible mais inerte : le faire disparaître
          laisserait croire que le renouvellement n'existe pas. %>
      <button type="button" class="bouton bouton-large" disabled>
        <%= t("app.admin.deja_renouvele_bouton") %>
      </button>
    <% end %>

    <% if loan.member.phone.present? %>
      <%= link_to lien_telephone(loan.member), class: "bouton bouton-contour bouton-large" do %>
        <%= t("app.admin.appeler") %> <span class="donnee ml-1"><%= loan.member.phone_country_code %> <%= loan.member.phone %></span>
      <% end %>
    <% else %>
      <p class="aide text-center"><%= t("app.admin.aucun_telephone") %></p>
    <% end %>
  </div>
</details>
