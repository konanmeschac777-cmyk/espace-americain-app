<%# Les trois étapes restent visibles en permanence : le bibliothécaire sait
    toujours où il en est et combien il lui reste à faire. %>
<ol class="flex gap-2 mb-5">
  <% [ [ 1, "Abonné" ], [ 2, "Ouvrage" ], [ 3, "Confirmer" ] ].each do |numero, libelle| %>
    <%
      etat = if numero < courante then :fait
             elsif numero == courante then :en_cours
             else :a_venir
             end

      pastille, texte = case etat
      when :fait     then [ "bg-dispo text-white", "text-dispo" ]
      when :en_cours then [ "bg-navy text-white", "text-encre font-bold" ]
      else                [ "bg-surface-alt text-texte-estompe border border-bordure-forte", "text-texte-estompe" ]
      end
    %>
    <li class="flex-1 flex items-center gap-2">
      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-bold <%= pastille %>">
        <%= etat == :fait ? "✓" : numero %>
      </span>
      <span class="text-sm <%= texte %>"><%= libelle %></span>
    </li>
  <% end %>
</ol>
