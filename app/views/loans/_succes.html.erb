<div class="relative flex flex-col items-center text-center pt-2">
  <span class="flex h-16 w-16 items-center justify-center rounded-full bg-dispo-fond mb-4">
    <span class="text-3xl font-bold text-dispo" aria-hidden="true">✓</span>
  </span>
  <p class="surtitre text-white/60"><%= t("app.pret.pret_enregistre") %></p>
  <h1 class="titre-ecran titre-ecran-clair mt-2" style="max-width: 12ch;"><%= t("app.pret.cest_note") %></h1>
</div>

<div class="carte relative mt-5 p-5">
  <div class="flex items-center gap-3 pb-4" style="border-bottom: 1px dashed var(--color-bordure-forte);">
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-navy text-white font-titre font-bold text-sm">
      <%= loan.member.first_name.first %><%= loan.member.last_name.first %>
    </span>
    <div class="min-w-0">
      <p class="font-titre font-bold text-encre truncate"><%= loan.member.full_name %></p>
      <p class="donnee text-sm text-texte-discret"><%= loan.member.card_number %></p>
    </div>
  </div>

  <div class="flex items-start gap-3 py-4" style="border-bottom: 1px dashed var(--color-bordure-forte);">
    <%= dos_livre(loan.book) %>
    <div class="min-w-0">
      <p class="surtitre"><%= nom_categorie(loan.book.category) %></p>
      <p class="titre-ouvrage mt-0.5"><%= loan.book.title %></p>
      <p class="text-sm italic text-texte-discret"><%= auteur(loan.book) %></p>
    </div>
  </div>

  <div class="pt-4 text-center">
    <p class="surtitre"><%= t("app.pret.a_rapporter_le") %></p>
    <p class="font-display font-semibold text-3xl text-navy leading-none mt-2">
      <%= date_courte(loan.due_on) %>
    </p>
    <p class="text-sm text-texte-discret mt-2">
      <%= t("app.pret.jours_renouvelable", jours: Setting.loan_days) %>
    </p>
  </div>
</div>

<div class="relative flex-1"></div>

<div class="relative flex flex-col gap-3">
  <%= link_to t("app.pret.enregistrer_autre_pret"), new_loan_path,
              class: "bouton bouton-large bg-white text-navy" %>
  <%= link_to t("app.pret.revenir_accueil"), root_path,
              class: "bouton bouton-large", style: "border:1px solid rgba(255,255,255,0.34); color:white;" %>
</div>
