<% content_for :title, t("app.admin.emprunts") %>

<%= render "shared/entete", titre: t("app.admin.emprunts_en_cours") %>

<main class="zone-ecran mx-auto w-full max-w-[430px] px-4 py-4">

  <% if flash[:notice] %>
    <p class="bandeau bandeau-info mb-4"><%= flash[:notice] %></p>
  <% end %>
  <% if flash[:alert] %>
    <p class="bandeau bandeau-attention mb-4"><%= flash[:alert] %></p>
  <% end %>

  <%# Les compteurs sont dans les puces : le bibliothécaire voit combien de
      retards il a sans changer d'écran. %>
  <div class="flex gap-2 overflow-x-auto pb-2 mb-4 -mx-4 px-4">
    <% libelles_filtres = { "tous" => t("app.admin.filtre_tous"), "cours" => t("app.admin.filtre_en_cours"),
                            "bientot" => t("app.admin.filtre_bientot"), "retard" => t("app.admin.filtre_retard") } %>
    <% LoansController::FILTRES.each_key do |cle| %>
      <%= link_to loans_path(filtre: cle),
                  class: "puce #{'puce-active' if @filtre == cle} #{'puce-travail' if cle == 'retard' && @filtre != cle && @compteurs['retard'].positive?}" do %>
        <%= libelles_filtres[cle] %>
        <span class="donnee"><%= @compteurs[cle] %></span>
      <% end %>
    <% end %>
  </div>

  <% if @loans.any? %>
    <ul class="flex flex-col gap-2">
      <% @loans.each do |loan| %>
        <li><%= render "emprunt", loan: loan %></li>
      <% end %>
    </ul>
  <% else %>
    <div class="etat-vide">
      <% case @filtre %>
      <% when "retard" %>
        <p class="etat-vide-titre"><%= t("app.abonnes.aucun_retard_titre") %></p>
        <p class="etat-vide-texte"><%= t("app.abonnes.aucun_retard_texte") %></p>
      <% when "bientot" %>
        <p class="etat-vide-titre"><%= t("app.admin.rien_a_reclamer_titre") %></p>
        <p class="etat-vide-texte"><%= t("app.admin.rien_a_reclamer_texte") %></p>
      <% when "cours" %>
        <p class="etat-vide-titre"><%= t("app.admin.aucun_tranquille_titre") %></p>
        <p class="etat-vide-texte">
          <%= t("app.admin.aucun_tranquille_texte") %>
        </p>
      <% else %>
        <p class="etat-vide-titre"><%= t("app.admin.aucun_sorti_titre") %></p>
        <p class="etat-vide-texte"><%= t("app.admin.aucun_sorti_texte", n: Book.active.sum(:total_copies)) %></p>
      <% end %>
    </div>
  <% end %>

</main>

<%= render "shared/nav", actif: :emprunts %>
