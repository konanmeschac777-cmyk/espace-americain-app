<span class="min-w-0 flex-1">
  <span class="surtitre"><%= book.category.name %></span>
  <span class="titre-ouvrage block"><%= book.title %></span>
  <span class="block text-sm text-texte-discret"><%= auteur(book) %></span>
  <% if book.shelf_mark.present? %>
    <span class="donnee block text-sm text-texte-estompe">Cote <%= book.shelf_mark %></span>
  <% end %>
</span>
<span class="shrink-0"><%= badge_disponibilite(book) %></span>
