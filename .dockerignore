# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Y compris ceux des sous-dossiers : deploy/.env porte la clé de déchiffrement
# des identifiants. La règle ci-dessus est ancrée à la racine, sans ces deux
# lignes la clé serait recopiée dans l'image au moment du build.
.env
.env.*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep

# Sauf la feuille de style compilée : le processeur du poste serveur ne peut
# pas exécuter le binaire Tailwind, l'image doit donc recevoir le résultat
# déjà construit plutôt que de le refabriquer. Voir .gitignore et le Dockerfile.
!/app/assets/builds/tailwind.css
/public/assets

# Ignore CI service files.
/.github

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*
